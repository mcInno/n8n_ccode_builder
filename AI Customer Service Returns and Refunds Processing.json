    {
      "parameters": {
        "jsCode": "function safeParse(value) {\n  if (value && typeof value === 'string') {\n    const trimmed = value.trim();\n    if (!trimmed) {\n      return null;\n    }\n    try {\n      return JSON.parse(trimmed);\n    } catch (error) {\n      const start = trimmed.indexOf('{');\n      const end = trimmed.lastIndexOf('}');\n      if (start !== -1 && end !== -1 && end > start) {\n        const candidate = trimmed.slice(start, end + 1);\n        try {\n          return JSON.parse(candidate);\n        } catch (innerError) {\n          return null;\n        }\n      }\n      return null;\n    }\n  }\n  return typeof value === 'object' && value !== null ? value : null;\n}\n\nconst extraction = safeParse($json.output) || {};\nconst rawOrderId = extraction.order_id ?? null;\nconst rawEmail = extraction.customer_email ?? null;\n\nconst cleanedOrderId = typeof rawOrderId === 'string' ? rawOrderId.trim() : rawOrderId;\nconst cleanedEmail = typeof rawEmail === 'string' ? rawEmail.trim() : rawEmail;\n\nconst freshOrderId = cleanedOrderId && cleanedOrderId !== 'null' && /^\\\\d{4}$/.test(String(cleanedOrderId)) ? String(cleanedOrderId) : null;\nconst freshEmail = cleanedEmail && cleanedEmail !== 'null' ? String(cleanedEmail) : null;\n\nconst sessionSource = $node[\"Customer Chat (Gladly)\"].item.json || {};\nconst sessionId = sessionSource.sessionId || sessionSource.chatSessionId || null;\nconst store = this.getWorkflowStaticData('global');\nconst sessionState = sessionId && store[sessionId] ? store[sessionId] : { orderId: null, email: null };\n\nif (freshOrderId) sessionState.orderId = freshOrderId;\nif (freshEmail) sessionState.email = freshEmail;\n\nif (sessionId) {\n  store[sessionId] = sessionState;\n}\n\nconst normalizedOrderId = sessionState.orderId || null;\nconst normalizedCustomerEmail = sessionState.email || null;\nconst missingFields = [];\nif (!normalizedOrderId) missingFields.push('your 4-digit order number');\nif (!normalizedCustomerEmail) missingFields.push('the email address used for the purchase');\n\nreturn [{ json: { ...$json, normalizedOrderId, normalizedCustomerEmail, missingFields, sessionId } }];"
      },
